# Default provider used by the current project.
LLM_PROVIDER=deepseek

# Optional generic OpenAI-compatible overrides for cross-model experiments.
# Leave blank to fall back to the DEEPSEEK_* values below when LLM_PROVIDER=deepseek.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TEMPERATURE=
LLM_REASONING_EFFORT=
LLM_THINKING=
LLM_JSON_MODE=enabled

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=enabled
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_TEMPERATURE=0.2

ONLINE_TOOLS_ENABLED=true
LBD_BACKEND=online
NCBI_EMAIL=
NCBI_API_KEY=
NCBI_TOOL=arrowsmith_multiagent
